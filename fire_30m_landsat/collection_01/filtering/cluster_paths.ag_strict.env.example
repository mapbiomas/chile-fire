# =============================================================================
# Comparación: agricultura estricta + relleno post-LULC (plantilla sin rutas locales)
#
# En NLHPC leftraru ver: cluster_paths.ag_strict.env.leftraru
#
#   cp filtering/cluster_paths.ag_strict.env.example filtering/cluster_paths.env
#   nano filtering/cluster_paths.env
#   source filtering/cluster_paths.env
#   bash filtering/run_filtering_pipeline.sh
# =============================================================================

export PYTHON="/path/to/your/env/bin/python"

export LULC_STACK="/path/to/lulc_collection02/lulc_stack_multiband.tif"
export START_YEAR_BAND1=2000

export CLASSIFIED_DIR="/path/to/classification_YYYYMMDD"
export WORK_ROOT="/path/to/filtering_work_ag_strict"
export FILTER_OUTPUT_DIR="${WORK_ROOT}/classified_filtered"

export FROM_YEAR=2013
export TO_YEAR=2025
export LULC_TO_YEAR=2024
export COPY_MASK_2025_FROM_2024=1

export LULC_STABILITY_WINDOW=4
export LULC_AGRICULTURE_STABILITY_WINDOW=1

export FILL_HOLES=1
export MAX_HOLE_AREA=0
export FILL_AGRICULTURAL_HOLES=1
export AGRICULTURE_MASKS_DIR="${WORK_ROOT}/mascaras/by_year"

export SKIP_MIN_PATCH_SIEVE=1
export WORKERS=4
export STEPS="all"
